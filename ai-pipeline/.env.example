# Required — get from https://build.nvidia.com (click "Get API Key")
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NVIDIA NIM model for vision + reasoning
# Default: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# NVIDIA NIM base URL
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1

# Whisper model size: tiny | base | small | medium | large
# "base" recommended — good accuracy, fast enough (<5s on CPU)
WHISPER_MODEL=base

# AI service port
PORT=8001

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
